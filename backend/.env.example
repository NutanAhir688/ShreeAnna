# Azure Blob Storage
# Copy this file to .env and fill in your real values.
# Never commit .env to source control.

AzureStorage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT_NAME;AccountKey=YOUR_ACCESS_KEY;EndpointSuffix=core.windows.net
AzureStorage__CdnBaseUrl=https://YOUR_ACCOUNT_NAME.blob.core.windows.net/farm-images

# MockGateway Razorpay Integration Keys
MockGateway__BaseUrl=https://mockgateway.com/api/base/YOUR_GATEWAY_SLUG
MockGateway__KeyId=YOUR_MOCKGATEWAY_KEY_ID
MockGateway__KeySecret=YOUR_MOCKGATEWAY_KEY_SECRET
MockGateway__AuthHeader=Basic YOUR_BASE64_AUTH_HEADER

