# ==============================================================================
# ShreeAnna Platform - Root Environment Configuration (.env.example)
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=shreeanna_user
POSTGRES_PASSWORD=shreeanna_dev
POSTGRES_DB=shreeanna
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Backend API (.NET 10 Web API)
# ------------------------------------------------------------------------------
BACKEND_PORT=5066
ASPNETCORE_ENVIRONMENT=Development
JWT_KEY=YOUR_LONG_RANDOM_SECRET_KEY_HERE_SHREEANNA_2026_VERY_SECURE
JWT_ISSUER=ShreeAnna
JWT_AUDIENCE=ShreeAnnaClient
JWT_EXPIRATION_MINUTES=60

# ------------------------------------------------------------------------------
# 3. Azure Blob Storage (Farm & Inspection Images)
# ------------------------------------------------------------------------------
AzureStorage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT_NAME;AccountKey=YOUR_ACCESS_KEY;EndpointSuffix=core.windows.net
AzureStorage__CdnBaseUrl=https://YOUR_ACCOUNT_NAME.blob.core.windows.net/farm-images
AzureStorage__AccountName=shreeannafarmimages
AzureStorage__ContainerName=farm-images

# ------------------------------------------------------------------------------
# 4. Razorpay MockGateway Integration
# ------------------------------------------------------------------------------
MockGateway__BaseUrl=https://mockgateway.com/api/base/YOUR_GATEWAY_SLUG
MockGateway__KeyId=YOUR_MOCKGATEWAY_KEY_ID
MockGateway__KeySecret=YOUR_MOCKGATEWAY_KEY_SECRET
MockGateway__AuthHeader=Basic YOUR_BASE64_AUTH_HEADER

# ------------------------------------------------------------------------------
# 5. Frontend Web Dashboard (React 19 + Vite)
# ------------------------------------------------------------------------------
WEBSITE_PORT=5173
VITE_API_BASE_URL=http://localhost:5066

# ------------------------------------------------------------------------------
# 6. Mobile Application (Flutter) & OTP Service (MSG91 SendOTP)
# ------------------------------------------------------------------------------
CARTO_API_KEY=your_carto_api_key_here
SENDOTP_WIDGET_ID=your_sendotp_widget_id_here
SENDOTP_AUTH_TOKEN=your_sendotp_auth_token_here
