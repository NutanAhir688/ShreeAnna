  <diagram id="NlI7v4EhvLFPMc1mncnL" name="UML Sequence Diagram">
    <mxGraphModel dx="1017" dy="1037" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle ShreeAnna - Millet Procurement Sequence\n\nactor Farmer\nparticipant \&quot;ShreeAnna System\&quot; as System\nparticipant FPO\nparticipant \&quot;Quality Inspector\&quot; as Inspector\nparticipant \&quot;Procurement Officer\&quot; as PO\nparticipant \&quot;Warehouse Officer\&quot; as WO\n\nFarmer -&gt; System : Create millet listing\nSystem -&gt; FPO : Notify new listing\n\nFPO -&gt; System : Review listing\nSystem -&gt; Farmer : Listing accepted\n\nFPO -&gt; System : Request quality inspection\nSystem -&gt; Inspector : Assign inspection\n\nInspector -&gt; System : Record inspection results\n\nalt Quality Approved\n    Inspector -&gt; System : Issue quality certificate\n    System -&gt; FPO : Inspection approved\n\n    FPO -&gt; PO : Request procurement\n    PO -&gt; System : Create procurement lot\n    PO -&gt; System : Create procurement agreement\n\n    System -&gt; Farmer : Confirm procurement\n\n    PO -&gt; WO : Schedule batch receiving\n    WO -&gt; System : Receive millet batch\n    System -&gt; WO : Create warehouse batch\n\n    System -&gt; Farmer : Procurement completed\n\nelse Quality Rejected\n    Inspector -&gt; System : Mark inspection failed\n    System -&gt; FPO : Quality rejected\n    FPO -&gt; Farmer : Notify rejection\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="J98dOD8BeyJfEQhJ8zjq-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
