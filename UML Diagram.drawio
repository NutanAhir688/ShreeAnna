        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle ShreeAnna - UML Class Diagram\n\nskinparam classAttributeIconSize 0\n\nclass FPO {\n    +fpoId : UUID\n    +name : String\n    +registrationNo : String\n    +contactNo : String\n    +address : String\n}\n\nclass Farmer {\n    +farmerId : UUID\n    +name : String\n    +phone : String\n    +address : String\n    +registrationDate : Date\n}\n\nclass Farm {\n    +farmId : UUID\n    +location : String\n    +area : Decimal\n    +soilType : String\n}\n\nclass ProcurementLot {\n    +lotId : UUID\n    +milletType : String\n    +quantity : Decimal\n    +harvestDate : Date\n    +status : String\n}\n\nclass Inspection {\n    +inspectionId : UUID\n    +inspectionDate : Date\n    +moisture : Decimal\n    +purity : Decimal\n    +grade : String\n    +status : String\n}\n\nclass QualityCertificate {\n    +certificateId : UUID\n    +certificateNo : String\n    +issueDate : Date\n    +validUntil : Date\n    +qualityGrade : String\n}\n\nclass ProcurementAgreement {\n    +agreementId : UUID\n    +agreementNo : String\n    +agreementDate : Date\n    +status : String\n}\n\nclass AgreementVersion {\n    +versionId : UUID\n    +versionNo : Integer\n    +effectiveDate : Date\n    +terms : Text\n}\n\nclass ProcessingBatch {\n    +batchId : UUID\n    +batchCode : String\n    +quantity : Decimal\n    +processingDate : Date\n}\n\nclass WarehouseBatch {\n    +warehouseBatchId : UUID\n    +batchCode : String\n    +quantity : Decimal\n    +status : String\n}\n\nclass Warehouse {\n    +warehouseId : UUID\n    +name : String\n    +location : String\n    +capacity : Decimal\n}\n\nclass PickupDelivery {\n    +deliveryId : UUID\n    +pickupDate : Date\n    +deliveryDate : Date\n    +status : String\n}\n\nclass Bill {\n    +billId : UUID\n    +billNo : String\n    +billDate : Date\n    +amount : Decimal\n    +paymentStatus : String\n}\n\nclass Buyer {\n    +buyerId : UUID\n    +name : String\n    +contactNo : String\n    +address : String\n}\n\nFPO \&quot;1\&quot; -- \&quot;0..*\&quot; Farmer : has\nFarmer \&quot;1\&quot; -- \&quot;1..*\&quot; Farm : owns\nFarm \&quot;1\&quot; -- \&quot;0..*\&quot; ProcurementLot : produces\n\nProcurementLot \&quot;1\&quot; -- \&quot;0..*\&quot; Inspection : undergoes\nInspection \&quot;1\&quot; -- \&quot;0..1\&quot; QualityCertificate : results in\n\nProcurementLot \&quot;1\&quot; -- \&quot;0..*\&quot; ProcurementAgreement : covered by\nProcurementAgreement \&quot;1\&quot; -- \&quot;1..*\&quot; AgreementVersion : has\n\nProcurementLot \&quot;1\&quot; -- \&quot;0..*\&quot; ProcessingBatch : processed into\nProcessingBatch \&quot;1\&quot; -- \&quot;1..*\&quot; WarehouseBatch : creates\n\nWarehouse \&quot;1\&quot; -- \&quot;0..*\&quot; WarehouseBatch : stores\n\nProcurementAgreement \&quot;1\&quot; -- \&quot;0..*\&quot; PickupDelivery : schedules\nPickupDelivery \&quot;1\&quot; -- \&quot;0..*\&quot; Bill : generates\n\nBuyer \&quot;1\&quot; -- \&quot;0..*\&quot; ProcurementAgreement : purchases\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fPL2YN8rRFVyn0feqzKb-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
