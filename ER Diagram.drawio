  <diagram id="u21rY39hjyQbKvHYatxC" name="Class Diagram">
    <mxGraphModel dx="1201" dy="629" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle ShreeAnna - UML Class Diagram\n\nskinparam classAttributeIconSize 0\n\nclass FPO {\n    +fpoId : UUID\n    +name : String\n    +registrationNo : String\n    +contactNo : String\n    +address : String\n\n    +registerFarmer() : void\n    +updateDetails() : void\n    +getFarmers() : List&lt;Farmer&gt;\n}\n\nclass Farmer {\n    +farmerId : UUID\n    +name : String\n    +phone : String\n    +address : String\n    +registrationDate : Date\n\n    +registerFarm() : void\n    +updateDetails() : void\n    +getProcurementLots() : List&lt;ProcurementLot&gt;\n}\n\nclass Farm {\n    +farmId : UUID\n    +location : String\n    +area : Decimal\n    +soilType : String\n\n    +addProcurementLot() : void\n    +updateFarmDetails() : void\n    +getProduction() : Decimal\n}\n\nclass ProcurementLot {\n    +lotId : UUID\n    +milletType : String\n    +quantity : Decimal\n    +harvestDate : Date\n    +status : String\n\n    +createLot() : void\n    +updateStatus() : void\n    +requestInspection() : void\n}\n\nclass Inspection {\n    +inspectionId : UUID\n    +inspectionDate : Date\n    +moisture : Decimal\n    +purity : Decimal\n    +grade : String\n    +status : String\n\n    +performInspection() : void\n    +calculateGrade() : String\n    +approveInspection() : void\n}\n\nclass QualityCertificate {\n    +certificateId : UUID\n    +certificateNo : String\n    +issueDate : Date\n    +validUntil : Date\n    +qualityGrade : String\n\n    +issueCertificate() : void\n    +validateCertificate() : Boolean\n    +renewCertificate() : void\n}\n\nclass ProcurementAgreement {\n    +agreementId : UUID\n    +agreementNo : String\n    +agreementDate : Date\n    +status : String\n\n    +createAgreement() : void\n    +updateAgreement() : void\n    +approveAgreement() : void\n    +getCurrentVersion() : AgreementVersion\n}\n\nclass AgreementVersion {\n    +versionId : UUID\n    +versionNo : Integer\n    +effectiveDate : Date\n    +terms : Text\n\n    +createVersion() : void\n    +updateTerms() : void\n    +activateVersion() : void\n}\n\nclass ProcessingBatch {\n    +batchId : UUID\n    +batchCode : String\n    +quantity : Decimal\n    +processingDate : Date\n\n    +createBatch() : void\n    +processMillet() : void\n    +updateQuantity() : void\n}\n\nclass WarehouseBatch {\n    +warehouseBatchId : UUID\n    +batchCode : String\n    +quantity : Decimal\n    +status : String\n\n    +storeBatch() : void\n    +updateStatus() : void\n    +getQuantity() : Decimal\n}\n\nclass Warehouse {\n    +warehouseId : UUID\n    +name : String\n    +location : String\n    +capacity : Decimal\n\n    +addBatch() : void\n    +removeBatch() : void\n    +checkCapacity() : Decimal\n}\n\nclass PickupDelivery {\n    +deliveryId : UUID\n    +pickupDate : Date\n    +deliveryDate : Date\n    +status : String\n\n    +schedulePickup() : void\n    +scheduleDelivery() : void\n    +updateStatus() : void\n}\n\nclass Bill {\n    +billId : UUID\n    +billNo : String\n    +billDate : Date\n    +amount : Decimal\n    +paymentStatus : String\n\n    +generateBill() : void\n    +calculateAmount() : Decimal\n    +markAsPaid() : void\n}\n\nclass Buyer {\n    +buyerId : UUID\n    +name : String\n    +contactNo : String\n    +address : String\n\n    +createAgreement() : void\n    +placeOrder() : void\n    +makePayment() : void\n}\n\nFPO \&quot;1\&quot; -- \&quot;0..*\&quot; Farmer : has\nFarmer \&quot;1\&quot; -- \&quot;1..*\&quot; Farm : owns\nFarm \&quot;1\&quot; -- \&quot;0..*\&quot; ProcurementLot : produces\n\nProcurementLot \&quot;1\&quot; -- \&quot;0..*\&quot; Inspection : undergoes\nInspection \&quot;1\&quot; -- \&quot;0..1\&quot; QualityCertificate : results in\n\nProcurementLot \&quot;1\&quot; -- \&quot;0..*\&quot; ProcurementAgreement : covered by\nProcurementAgreement \&quot;1\&quot; -- \&quot;1..*\&quot; AgreementVersion : has\n\nProcurementLot \&quot;1\&quot; -- \&quot;0..*\&quot; ProcessingBatch : processed into\nProcessingBatch \&quot;1\&quot; -- \&quot;1..*\&quot; WarehouseBatch : creates\n\nWarehouse \&quot;1\&quot; -- \&quot;0..*\&quot; WarehouseBatch : stores\n\nProcurementAgreement \&quot;1\&quot; -- \&quot;0..*\&quot; PickupDelivery : schedules\nPickupDelivery \&quot;1\&quot; -- \&quot;0..*\&quot; Bill : generates\n\nBuyer \&quot;1\&quot; -- \&quot;0..*\&quot; ProcurementAgreement : purchases\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ugTcWZ7sFiglgStJbibs-1">
