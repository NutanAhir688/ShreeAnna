  <diagram id="rT4IIfCMPbqGYP0bTtCT" name="State Diagram">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\ntitle ShreeAnna Smart Millet Platform - State Diagram\n\n[*] --&gt; Draft\n\nDraft --&gt; Submitted : Farmer submits lot\n\nSubmitted --&gt; InspectionPending : FPO requests inspection\n\nInspectionPending --&gt; QualityInspection : Inspector assigned\n\nQualityInspection --&gt; Certified : Quality approved\nQualityInspection --&gt; Rejected : Quality rejected\n\nRejected --&gt; Draft : Farmer resubmits / corrects lot\n\nCertified --&gt; FarmerAgreementPending : FPO creates agreement\n\nFarmerAgreementPending --&gt; FarmerAgreementAccepted : Farmer accepts\nFarmerAgreementPending --&gt; FarmerAgreementRejected : Farmer rejects\n\nFarmerAgreementRejected --&gt; FarmerAgreementPending : Agreement revised\n\nFarmerAgreementAccepted --&gt; ShipmentScheduled : Inbound shipment requested\n\nShipmentScheduled --&gt; VehicleAssigned : Vehicle assigned\n\nVehicleAssigned --&gt; PickupConfirmed : Millet picked up\n\nPickupConfirmed --&gt; InTransit : Shipment starts\n\nInTransit --&gt; WarehouseReceiving : Delivered to warehouse\n\nWarehouseReceiving --&gt; QuantityVerified : Quantity verified\n\nQuantityVerified --&gt; Stored : Warehouse batch created\n\nStored --&gt; AvailableForSale : Stock available for Processor / SHG\n\nAvailableForSale --&gt; PurchaseRequested : Processor / SHG submits request\n\nPurchaseRequested --&gt; ProcessorAgreementPending : FPO proposes agreement\n\nProcessorAgreementPending --&gt; ProcessorAgreementAccepted : Processor / SHG accepts\n\nProcessorAgreementPending --&gt; ProcessorAgreementRejected : Processor / SHG rejects\n\nProcessorAgreementRejected --&gt; AvailableForSale : Lot remains available\n\nProcessorAgreementAccepted --&gt; PaymentPending : Payment required\n\nPaymentPending --&gt; PaymentConfirmed : Payment verified\n\nPaymentPending --&gt; PaymentFailed : Payment failed\n\nPaymentFailed --&gt; PaymentPending : Retry payment\n\nPaymentConfirmed --&gt; ReservedForDispatch : Stock reserved\n\nReservedForDispatch --&gt; OutboundShipmentScheduled : Outbound shipment created\n\nOutboundShipmentScheduled --&gt; OutboundVehicleAssigned : Vehicle assigned\n\nOutboundVehicleAssigned --&gt; OutboundInTransit : Shipment dispatched\n\nOutboundInTransit --&gt; DeliveredToProcessor : Delivered to Processor / SHG\n\nDeliveredToProcessor --&gt; Completed : Delivery confirmed\n\nCompleted --&gt; [*]\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6bD8-3muOtYvjSE1IPBf-28">
