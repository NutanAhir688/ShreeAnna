      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\n[*] --&gt; Draft\n\nDraft --&gt; Submitted : Farmer submits listing\n\nSubmitted --&gt; \&quot;FPO Review\&quot; : FPO receives listing\n\n\&quot;FPO Review\&quot; --&gt; \&quot;Inspection Pending\&quot; : Inspection required\n\n\&quot;FPO Review\&quot; --&gt; Rejected : Listing rejected\n\n\&quot;Inspection Pending\&quot; --&gt; \&quot;Inspection In Progress\&quot; : QI starts inspection\n\n\&quot;Inspection In Progress\&quot; --&gt; \&quot;Inspection Completed\&quot; : QI submits result\n\n\&quot;Inspection Completed\&quot; --&gt; Certified : Quality approved\n\n\&quot;Inspection Completed\&quot; --&gt; Rejected : Quality failed\n\nCertified --&gt; \&quot;Marketplace Available\&quot; : Product published\n\n\&quot;Marketplace Available\&quot; --&gt; Sold : Quantity exhausted\n\nRejected --&gt; [*]\nSold --&gt; [*]\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6bD8-3muOtYvjSE1IPBf-28">
