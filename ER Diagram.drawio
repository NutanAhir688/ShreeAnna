  <diagram id="fSUWKyQTFkl-BiRPY9ok" name="Level-0 DFD">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nleft to right direction\n\nskinparam shadowing false\n\n&#39; =====================================================\n&#39; EXTERNAL ENTITIES\n&#39; =====================================================\n\nrectangle \&quot;Farmer\&quot; as Farmer\nrectangle \&quot;FPO / Procurement Officer\&quot; as FPO\nrectangle \&quot;Quality Inspector\&quot; as QI\nrectangle \&quot;Logistics Officer\&quot; as LO\nrectangle \&quot;Warehouse Officer\&quot; as WO\nrectangle \&quot;Processor / SHG\&quot; as Processor\nrectangle \&quot;Finance Officer\&quot; as Finance\nrectangle \&quot;Consumer\&quot; as Consumer\nrectangle \&quot;Administrator\&quot; as Admin\n\n&#39; =====================================================\n&#39; MAIN SYSTEM\n&#39; =====================================================\n\ncircle \&quot;0\\nShreeAnna Smart Millet\\nValue Chain Management System\&quot; as System\n\n&#39; =====================================================\n&#39; DATA STORES\n&#39; =====================================================\n\ndatabase \&quot;D1\\nUser Database\&quot; as D1\ndatabase \&quot;D2\\nProcurement Lot DB\&quot; as D2\ndatabase \&quot;D3\\nInspection &amp;\\nCertification DB\&quot; as D3\ndatabase \&quot;D4\\nAgreement DB\&quot; as D4\ndatabase \&quot;D5\\nShipment &amp;\\nLogistics DB\&quot; as D5\ndatabase \&quot;D6\\nWarehouse &amp;\\nInventory DB\&quot; as D6\ndatabase \&quot;D7\\nPayment Database\&quot; as D7\ndatabase \&quot;D8\\nMarketplace DB\&quot; as D8\ndatabase \&quot;D9\\nOrder Database\&quot; as D9\n\n&#39; =====================================================\n&#39; FARMER\n&#39; =====================================================\n\nFarmer --&gt; System : 1. Registration / Login\nFarmer --&gt; System : 2. Procurement Lot Details\nSystem --&gt; Farmer : 3. Agreement / Quality / Shipment Notifications\n\n&#39; =====================================================\n&#39; FPO / PROCUREMENT OFFICER\n&#39; =====================================================\n\nFPO --&gt; System : 4. Login\nFPO --&gt; System : 5. Lot / Procurement Details\nFPO --&gt; System : 6. Farmer / Processor Agreement Details\nSystem --&gt; FPO : 7. Procurement / Agreement / Payment Status\n\n&#39; =====================================================\n&#39; QUALITY INSPECTOR\n&#39; =====================================================\n\nQI --&gt; System : 8. Login\nQI --&gt; System : 9. Inspection Results\nSystem --&gt; QI : 10. Inspection Requests / Notifications\n\n&#39; =====================================================\n&#39; LOGISTICS OFFICER\n&#39; =====================================================\n\nLO --&gt; System : 11. Login\nLO --&gt; System : 12. Shipment / Vehicle Details\nSystem --&gt; LO : 13. Pickup / Delivery Requests / Status\n\n&#39; =====================================================\n&#39; WAREHOUSE OFFICER\n&#39; =====================================================\n\nWO --&gt; System : 14. Login\nWO --&gt; System : 15. Receiving / Inventory Details\nSystem --&gt; WO : 16. Shipment / Stock Requests / Notifications\n\n&#39; =====================================================\n&#39; PROCESSOR / SHG\n&#39; =====================================================\n\nProcessor --&gt; System : 17. Login / Browse Available Lots\nProcessor --&gt; System : 18. Purchase Request\nProcessor --&gt; System : 19. Agreement Acceptance / Rejection\nProcessor --&gt; System : 20. Payment Details\nProcessor --&gt; System : 21. Product Listing Details\nSystem --&gt; Processor : 22. Lot / Agreement / Shipment / Order Status\n\n&#39; =====================================================\n&#39; FINANCE OFFICER\n&#39; =====================================================\n\nFinance --&gt; System : 23. Login\nFinance --&gt; System : 24. Payment Verification / Transaction Details\nSystem --&gt; Finance : 25. Payment / Transaction Status\n\n&#39; =====================================================\n&#39; CONSUMER\n&#39; =====================================================\n\nConsumer --&gt; System : 26. Login / Product Search\nConsumer --&gt; System : 27. Order Details\nSystem --&gt; Consumer : 28. Product Information / Order Status\n\n&#39; =====================================================\n&#39; ADMINISTRATOR\n&#39; =====================================================\n\nAdmin --&gt; System : 29. User / System Management\nSystem --&gt; Admin : 30. Reports / Monitoring Data\n\n&#39; =====================================================\n&#39; DATA STORES\n&#39; =====================================================\n\nSystem --&gt; D1 : 31. User Data\nD1 --&gt; System : 32. User Information\n\nSystem --&gt; D2 : 33. Procurement Lot Data\nD2 --&gt; System : 34. Lot Status / Availability\n\nSystem --&gt; D3 : 35. Inspection / Certification Data\nD3 --&gt; System : 36. Quality / Certification Records\n\nSystem --&gt; D4 : 37. Agreement Data\nD4 --&gt; System : 38. Agreement Status\n\nSystem --&gt; D5 : 39. Shipment / Logistics Data\nD5 --&gt; System : 40. Shipment Status\n\nSystem --&gt; D6 : 41. Warehouse / Inventory Data\nD6 --&gt; System : 42. Stock / Batch Status\n\nSystem --&gt; D7 : 43. Payment Data\nD7 --&gt; System : 44. Payment Status\n\nSystem --&gt; D8 : 45. Product Listing Data\nD8 --&gt; System : 46. Marketplace Information\n\nSystem --&gt; D9 : 47. Order Data\nD9 --&gt; System : 48. Order Status\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FC6DxOY-vuhBF6Yb4fDd-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
