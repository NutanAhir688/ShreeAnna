  <diagram name="Copy of Activity Diagram" id="ElV53nECbdu-NFVjYTUB">
    <mxGraphModel dx="2967" dy="1763" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="FiPgsCd1eDhH-x1dpdee-0" />
        <mxCell id="FiPgsCd1eDhH-x1dpdee-1" parent="FiPgsCd1eDhH-x1dpdee-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle ShreeAnna Smart Millet Platform - Activity Diagram\n\nskinparam shadowing false\nskinparam activity {\n    BackgroundColor white\n    BorderColor black\n    FontColor black\n    StartColor black\n    EndColor black\n    DiamondBackgroundColor white\n    DiamondBorderColor black\n    ArrowColor black\n}\n\nstart\n\n:Farmer creates Procurement Lot;\n:FPO reviews Procurement Lot;\n\nif (Lot accepted?) then (Yes)\n\n    :Request Quality Inspection;\n    :Assign Quality Inspector;\n    :Inspector inspects Millet Lot;\n    :Record Quality Observations;\n\n    if (Quality passed?) then (Yes)\n\n        :Issue Quality Certificate;\n        :FPO negotiates Farmer Purchase;\n        :Create Farmer Purchase Agreement;\n\n        if (Farmer accepts?) then (Yes)\n\n            :Process Farmer Payment;\n\n            fork\n                :Schedule Inbound Shipment;\n                :Assign Vehicle / Driver;\n            fork again\n                :Prepare Warehouse Storage;\n            end fork\n\n            :Pickup Millet from Farmer;\n            :Deliver Millet to Warehouse;\n            :Verify Received Quantity;\n\n            if (Quantity / Condition acceptable?) then (Yes)\n\n                :Create Warehouse Receipt;\n                :Create Inventory Batch;\n                :Store Millet in Warehouse;\n\n                :Processor / SHG browses Available Lots;\n                :Submit Purchase Request;\n                :FPO reviews Purchase Request;\n                :Create Processor / SHG Agreement;\n\n                if (Agreement accepted?) then (Yes)\n\n                    :Processor / SHG makes Payment;\n\n                    :Create Outbound Shipment;\n                    :Assign Vehicle / Driver;\n                    :Dispatch Millet;\n                    :Deliver Millet to Processor / SHG;\n\n                    :Processor / SHG performs own Processing;\n                    :Create Finished Product;\n                    :Create Marketplace Listing;\n                    :Publish Product;\n\n                    :Consumer browses Products;\n                    :Consumer places Order;\n                    :Process Consumer Payment;\n                    :Deliver Product to Consumer;\n\n                else (No)\n\n                    :Reject / Counter Purchase Agreement;\n\n                endif\n\n            else (No)\n\n                :Record Quantity / Condition Discrepancy;\n                :Resolve Warehouse Receipt Issue;\n\n            endif\n\n        else (No)\n\n            :Reject / Renegotiate Farmer Agreement;\n\n        endif\n\n    else (No)\n\n        :Reject Procurement Lot;\n        :Record Rejection Reason;\n\n    endif\n\nelse (No)\n\n    :Return / Reject Procurement Lot;\n\nendif\n\nstop\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="YoFpQBJS6izmK6UVpcnv-0">
          <mxCell connectable="0" parent="FiPgsCd1eDhH-x1dpdee-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="2400" width="2398" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlId="start_0" plantUmlBaseStyle="ellipse;fillColor=#222222;strokeColor=#222222;" plantUmlBaseValue="" id="YoFpQBJS6izmK6UVpcnv-1">
          <mxCell parent="YoFpQBJS6izmK6UVpcnv-0" style="ellipse;fillColor=#222222;strokeColor=#222222;" vertex="1">
            <mxGeometry height="20" width="20" x="2128" y="30" as="geometry" />
