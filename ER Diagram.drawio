        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nleft to right direction\n\nrectangle \&quot;Farmer\&quot; as Farmer\nrectangle \&quot;FPO\&quot; as FPO\nrectangle \&quot;Quality Inspector\&quot; as QI\nrectangle \&quot;Buyer\&quot; as Buyer\nrectangle \&quot;Administrator\&quot; as Admin\n\ncircle \&quot;User Management\&quot; as UserManagement\ncircle \&quot;Listing Management\&quot; as ListingManagement\ncircle \&quot;Quality Verification\&quot; as QualityVerification\ncircle \&quot;Certification\&quot; as Certification\ncircle \&quot;Marketplace\&quot; as Marketplace\ncircle \&quot;Order Management\&quot; as OrderManagement\ncircle \&quot;Notification\&quot; as Notification\n\ndatabase \&quot;D1\\nUser Database\&quot; as D1\ndatabase \&quot;D2\\nProduct &amp; Listing DB\&quot; as D2\ndatabase \&quot;D3\\nInspection &amp; Certification DB\&quot; as D3\ndatabase \&quot;D4\\nOrder Database\&quot; as D4\n\n&#39;--- 1. User Management ---\nFarmer --&gt; UserManagement : 1. Registration / Login\nFPO --&gt; UserManagement : 2. Login\nQI --&gt; UserManagement : 3. Login\nBuyer --&gt; UserManagement : 4. Login\nAdmin --&gt; UserManagement : 5. Login\n\nUserManagement --&gt; D1 : 6. User data\nD1 --&gt; UserManagement : 7. User information\n\n&#39;--- 2. Listing Management ---\nFarmer --&gt; ListingManagement : 8. Product listing\nListingManagement --&gt; D2 : 9. Store listing\nD2 --&gt; ListingManagement : 10. Listing status\n\nFPO --&gt; ListingManagement : 11. Review listing\n\n&#39;--- 3. Quality Verification ---\nListingManagement --&gt; QualityVerification : 12. Inspection request\nQI --&gt; QualityVerification : 13. Inspection result\nQualityVerification --&gt; D3 : 14. Inspection data\nD3 --&gt; QualityVerification : 15. Inspection records\n\n&#39;--- 4. Certification ---\nQualityVerification --&gt; Certification : 16. Approved lot\nCertification --&gt; D3 : 17. Certification data\n\n&#39;--- 5. Marketplace ---\nCertification --&gt; Marketplace : 18. Certified product\nD2 --&gt; Marketplace : 19. Product data\nBuyer --&gt; Marketplace : 20. Search / View\nMarketplace --&gt; Buyer : 21. Product information\n\n&#39;--- 6. Order Management ---\nBuyer --&gt; OrderManagement : 22. Place order\nOrderManagement --&gt; D4 : 23. Order data\nD4 --&gt; OrderManagement : 24. Order status\nOrderManagement --&gt; Buyer : 25. Order status\n\n&#39;--- 7. Notification ---\nNotification --&gt; Farmer : 26. Notifications\nNotification --&gt; FPO : 27. Notifications\nNotification --&gt; QI : 28. Notifications\nNotification --&gt; Buyer : 29. Notifications\n\n&#39;--- Administrator ---\nAdmin --&gt; UserManagement : 30. Manage users\nAdmin --&gt; ListingManagement : 31. Monitor listings\nAdmin --&gt; QualityVerification : 32. Monitor inspections\nAdmin --&gt; Certification : 33. Monitor certifications\nAdmin --&gt; OrderManagement : 34. Monitor orders\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="pz1CAvmGqrhZh0oQEaJ8-2">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
