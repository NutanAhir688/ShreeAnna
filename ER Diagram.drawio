  <diagram name="Copy of Use Case Diagram" id="d_GBLkasPli1EHvj7xg1">
    <mxGraphModel dx="3370" dy="1195" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="MgjXFrB0o8tqnVMefJgv-0" />
        <mxCell id="MgjXFrB0o8tqnVMefJgv-1" parent="MgjXFrB0o8tqnVMefJgv-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle ShreeAnna Smart Millet Platform - Use Case Diagram\n\nleft to right direction\n\nskinparam packageStyle rectangle\nskinparam shadowing false\nskinparam actorStyle stickman\n\nskinparam usecase {\n    BackgroundColor #F8FAFC\n    BorderColor #166534\n}\n\nskinparam rectangle {\n    BorderColor #166534\n}\n\n&#39; =====================================================\n&#39; ACTORS\n&#39; =====================================================\n\nactor Farmer\nactor \&quot;FPO Coordinator /\\nProcurement Officer\&quot; as FPO\nactor \&quot;Quality Inspector\&quot; as QI\nactor \&quot;Logistics Officer\&quot; as LO\nactor \&quot;Warehouse Officer\&quot; as WO\nactor \&quot;Processor / SHG\&quot; as PS\nactor Consumer\nactor \&quot;Finance Officer\&quot; as FO\n\n\nrectangle \&quot;ShreeAnna Smart Millet Platform\&quot; {\n\n    &#39; =================================================\n    &#39; FARMER &amp; LOT\n    &#39; =================================================\n\n    usecase \&quot;Manage Farmer Profile\&quot; as UC1\n    usecase \&quot;Create Procurement Lot\&quot; as UC2\n    usecase \&quot;View Lot Status\&quot; as UC3\n\n    usecase \&quot;Request Quality Inspection\&quot; as UC4\n    usecase \&quot;Inspect Millet Lot\&quot; as UC5\n    usecase \&quot;Record Quality Parameters\&quot; as UC6\n    usecase \&quot;Issue Quality Certificate\&quot; as UC7\n\n    &#39; =================================================\n    &#39; FARMER PROCUREMENT AGREEMENT\n    &#39; =================================================\n\n    usecase \&quot;Negotiate Farmer Purchase\&quot; as UC8\n    usecase \&quot;Formulate Farmer\\nPurchase Agreement\&quot; as UC9\n    usecase \&quot;Approve Farmer Agreement\&quot; as UC10\n    usecase \&quot;Process Farmer Payment\&quot; as UC11\n\n    &#39; =================================================\n    &#39; INBOUND LOGISTICS &amp; WAREHOUSE\n    &#39; =================================================\n\n    usecase \&quot;Schedule Inbound Shipment\&quot; as UC12\n    usecase \&quot;Assign Vehicle &amp; Driver\&quot; as UC13\n    usecase \&quot;Confirm Farmer Pickup\&quot; as UC14\n    usecase \&quot;Track Inbound Shipment\&quot; as UC15\n    usecase \&quot;Confirm Warehouse Delivery\&quot; as UC16\n\n    usecase \&quot;Receive Millet at Warehouse\&quot; as UC17\n    usecase \&quot;Verify Received Quantity\&quot; as UC18\n    usecase \&quot;Create Warehouse Receipt\&quot; as UC19\n    usecase \&quot;Create Inventory Batch\&quot; as UC20\n    usecase \&quot;Manage Warehouse Stock\&quot; as UC21\n    usecase \&quot;Transfer / Move Stock\&quot; as UC22\n\n    &#39; =================================================\n    &#39; PROCESSOR / SHG PURCHASE\n    &#39; =================================================\n\n    usecase \&quot;Browse Available Millet Lots\&quot; as UC23\n    usecase \&quot;View Lot &amp; Quality Details\&quot; as UC24\n    usecase \&quot;Submit Purchase Request\&quot; as UC25\n\n    usecase \&quot;Review Purchase Request\&quot; as UC26\n    usecase \&quot;Formulate Processor /\\nSHG Purchase Agreement\&quot; as UC27\n    usecase \&quot;Review Purchase Agreement\&quot; as UC28\n    usecase \&quot;Accept Agreement\&quot; as UC29\n    usecase \&quot;Reject / Counter Agreement\&quot; as UC30\n    usecase \&quot;Make Processor /\\nSHG Payment\&quot; as UC31\n\n    &#39; =================================================\n    &#39; OUTBOUND LOGISTICS\n    &#39; =================================================\n\n    usecase \&quot;Create Outbound Shipment\&quot; as UC32\n    usecase \&quot;Schedule Delivery\&quot; as UC33\n    usecase \&quot;Assign Outbound Vehicle\&quot; as UC34\n    usecase \&quot;Confirm Dispatch\&quot; as UC35\n    usecase \&quot;Track Outbound Shipment\&quot; as UC36\n    usecase \&quot;Confirm Delivery to\\nProcessor / SHG\&quot; as UC37\n\n    &#39; =================================================\n    &#39; MARKETPLACE\n    &#39; =================================================\n\n    usecase \&quot;Create Product Listing\&quot; as UC38\n    usecase \&quot;Manage Product Listing\&quot; as UC39\n    usecase \&quot;Publish Finished Product\&quot; as UC40\n\n    usecase \&quot;Browse Products\&quot; as UC41\n    usecase \&quot;View Product Details\&quot; as UC42\n    usecase \&quot;View Product Traceability\&quot; as UC43\n    usecase \&quot;Place Consumer Order\&quot; as UC44\n    usecase \&quot;Make Consumer Payment\&quot; as UC45\n    usecase \&quot;Track Consumer Order\&quot; as UC46\n\n    &#39; =================================================\n    &#39; FINANCE\n    &#39; =================================================\n\n    usecase \&quot;View Financial Transactions\&quot; as UC47\n\n\n    &#39; =================================================\n    &#39; INCLUDE RELATIONSHIPS\n    &#39; =================================================\n\n    UC4 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\n    UC5 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\n    UC5 ..&gt; UC7 : &lt;&lt;include&gt;&gt;\n\n    UC8 ..&gt; UC9 : &lt;&lt;include&gt;&gt;\n    UC9 ..&gt; UC10 : &lt;&lt;include&gt;&gt;\n    UC10 ..&gt; UC11 : &lt;&lt;include&gt;&gt;\n\n    UC12 ..&gt; UC13 : &lt;&lt;include&gt;&gt;\n    UC13 ..&gt; UC14 : &lt;&lt;include&gt;&gt;\n    UC14 ..&gt; UC15 : &lt;&lt;include&gt;&gt;\n    UC15 ..&gt; UC16 : &lt;&lt;include&gt;&gt;\n\n    UC17 ..&gt; UC18 : &lt;&lt;include&gt;&gt;\n    UC18 ..&gt; UC19 : &lt;&lt;include&gt;&gt;\n    UC19 ..&gt; UC20 : &lt;&lt;include&gt;&gt;\n\n    UC25 ..&gt; UC24 : &lt;&lt;include&gt;&gt;\n    UC26 ..&gt; UC27 : &lt;&lt;include&gt;&gt;\n    UC28 ..&gt; UC29 : &lt;&lt;include&gt;&gt;\n    UC29 ..&gt; UC31 : &lt;&lt;include&gt;&gt;\n\n    UC32 ..&gt; UC33 : &lt;&lt;include&gt;&gt;\n    UC33 ..&gt; UC34 : &lt;&lt;include&gt;&gt;\n    UC34 ..&gt; UC35 : &lt;&lt;include&gt;&gt;\n    UC35 ..&gt; UC36 : &lt;&lt;include&gt;&gt;\n    UC36 ..&gt; UC37 : &lt;&lt;include&gt;&gt;\n\n    UC38 ..&gt; UC39 : &lt;&lt;include&gt;&gt;\n    UC39 ..&gt; UC40 : &lt;&lt;include&gt;&gt;\n\n    UC41 ..&gt; UC42 : &lt;&lt;include&gt;&gt;\n    UC42 ..&gt; UC43 : &lt;&lt;include&gt;&gt;\n    UC44 ..&gt; UC45 : &lt;&lt;include&gt;&gt;\n    UC44 ..&gt; UC46 : &lt;&lt;include&gt;&gt;\n\n\n    &#39; =================================================\n    &#39; EXTEND RELATIONSHIPS\n    &#39; =================================================\n\n    UC3 ..&gt; UC2 : &lt;&lt;extend&gt;&gt;\n\n    UC30 ..&gt; UC28 : &lt;&lt;extend&gt;&gt;\n\n    UC22 ..&gt; UC21 : &lt;&lt;extend&gt;&gt;\n\n    UC43 ..&gt; UC42 : &lt;&lt;extend&gt;&gt;\n\n}\n\n\n&#39; =====================================================\n&#39; ACTOR ASSOCIATIONS\n&#39; =====================================================\n\nFarmer --&gt; UC1\nFarmer --&gt; UC2\nFarmer --&gt; UC3\n\nFPO --&gt; UC1\nFPO --&gt; UC2\nFPO --&gt; UC3\nFPO --&gt; UC4\nFPO --&gt; UC8\nFPO --&gt; UC9\nFPO --&gt; UC10\n\nQI --&gt; UC5\nQI --&gt; UC6\nQI --&gt; UC7\n\nLO --&gt; UC12\nLO --&gt; UC13\nLO --&gt; UC14\nLO --&gt; UC15\nLO --&gt; UC16\n\nWO --&gt; UC17\nWO --&gt; UC18\nWO --&gt; UC19\nWO --&gt; UC20\nWO --&gt; UC21\nWO --&gt; UC22\n\nPS --&gt; UC23\nPS --&gt; UC24\nPS --&gt; UC25\nPS --&gt; UC28\nPS --&gt; UC29\nPS --&gt; UC30\nPS --&gt; UC31\n\nFPO --&gt; UC26\nFPO --&gt; UC27\n\nLO --&gt; UC32\nLO --&gt; UC33\nLO --&gt; UC34\nLO --&gt; UC35\nLO --&gt; UC36\nLO --&gt; UC37\n\nPS --&gt; UC37\n\nPS --&gt; UC38\nPS --&gt; UC39\nPS --&gt; UC40\n\nConsumer --&gt; UC41\nConsumer --&gt; UC42\nConsumer --&gt; UC43\nConsumer --&gt; UC44\nConsumer --&gt; UC45\nConsumer --&gt; UC46\n\nFO --&gt; UC11\nFO --&gt; UC31\nFO --&gt; UC45\nFO --&gt; UC47\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="U7OqEQl6o1Pbs3sb5b5c-0">
