        <UserObject label="ShreeAnna - Millet Procurement Sequence Diagram" plantUmlId="title_60" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="ShreeAnna - Millet Procurement Sequence Diagram" id="n5ThY_vcF12e-PCLl_aY-62">
          <mxCell parent="n5ThY_vcF12e-PCLl_aY-1" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
