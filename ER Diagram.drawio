  <diagram id="cbKtdgC0ZymNI6Xjhmy7" name="Sequence Diagram">
    <mxGraphModel dx="1638" dy="858" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle ShreeAnna - Millet Procurement Sequence Diagram\n\nautonumber\n\nactor Farmer\nparticipant \&quot;ShreeAnna System\&quot; as System\nparticipant FPO\nparticipant \&quot;Quality Inspector\&quot; as Inspector\nparticipant \&quot;Procurement Officer\&quot; as PO\nparticipant \&quot;Warehouse Officer\&quot; as WO\n\n== Millet Listing ==\n\nactivate Farmer\nFarmer -&gt; System : Create millet listing\nactivate System\n\nSystem -&gt; FPO : Notify new listing\nactivate FPO\n\nFPO --&gt; System : Listing reviewed\ndeactivate FPO\n\nSystem --&gt; Farmer : Listing accepted\ndeactivate System\ndeactivate Farmer\n\n== Quality Inspection ==\n\nactivate FPO\nFPO -&gt; System : Request quality inspection\nactivate System\n\nSystem -&gt; Inspector : Assign inspection\nactivate Inspector\n\nInspector -&gt; System : Record inspection results\n\nalt Quality Approved\n\n    Inspector -&gt; System : Issue quality certificate\n    System --&gt; FPO : Inspection approved\n\n    deactivate Inspector\n    deactivate System\n    deactivate FPO\n\n    == Procurement ==\n\n    activate FPO\n    FPO -&gt; PO : Request procurement\n    activate PO\n\n    PO -&gt; System : Create procurement lot\n    activate System\n\n    PO -&gt; System : Create procurement agreement\n\n    System --&gt; Farmer : Confirm procurement\n\n    deactivate System\n    deactivate PO\n    deactivate FPO\n\n    == Warehouse Receiving ==\n\n    activate PO\n    PO -&gt; WO : Schedule batch receiving\n    activate WO\n\n    WO -&gt; System : Receive millet batch\n    activate System\n\n    System -&gt; WO : Create warehouse batch\n\n    deactivate System\n    deactivate WO\n    deactivate PO\n\n    == Completion ==\n\n    System -&gt; Farmer : Procurement completed\n\nelse Quality Rejected\n\n    Inspector -&gt; System : Mark inspection failed\n    System --&gt; FPO : Quality rejected\n\n    deactivate Inspector\n    deactivate System\n\n    FPO -&gt; Farmer : Notify rejection\n    deactivate FPO\n\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="n5ThY_vcF12e-PCLl_aY-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
