  <diagram name="Copy of Class Diagram" id="431--212LtB0NeWvT_Gb">
    <mxGraphModel dx="3024" dy="1834" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="lgfzOhbe9lmp-KjFJ8Zx-0" />
        <mxCell id="lgfzOhbe9lmp-KjFJ8Zx-1" parent="lgfzOhbe9lmp-KjFJ8Zx-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle ShreeAnna Smart Millet Platform - UML Class Diagram\n\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nskinparam linetype ortho\n\n&#39; =====================================================\n&#39; ACTORS / ORGANIZATIONAL ENTITIES\n&#39; =====================================================\n\nclass Farmer {\n    +farmerId: UUID\n    +name: String\n    +phone: String\n    +address: String\n    +registrationDate: Date\n    --\n    +registerFarmer(): void\n    +updateDetails(): void\n}\n\nclass FPO {\n    +fpoId: UUID\n    +name: String\n    +registrationNo: String\n    +contactNo: String\n    +address: String\n    --\n    +registerFarmer(): void\n    +updateFarmerDetails(): void\n    +manageProcurementLot(): void\n}\n\nclass QualityInspector {\n    +inspectorId: UUID\n    +name: String\n    +contactNo: String\n    --\n    +inspectLot(): void\n    +recordQualityParameters(): void\n}\n\nclass LogisticsOfficer {\n    +officerId: UUID\n    +name: String\n    +contactNo: String\n    --\n    +scheduleShipment(): void\n    +assignVehicle(): void\n    +trackShipment(): void\n}\n\nclass WarehouseOfficer {\n    +officerId: UUID\n    +name: String\n    +contactNo: String\n    --\n    +receiveShipment(): void\n    +verifyQuantity(): void\n    +manageInventory(): void\n}\n\nclass FinanceOfficer {\n    +officerId: UUID\n    +name: String\n    +contactNo: String\n    --\n    +processPayment(): void\n    +viewTransactions(): void\n}\n\n&#39; =====================================================\n&#39; FARMER PROCUREMENT\n&#39; =====================================================\n\nclass ProcurementLot {\n    +lotId: UUID\n    +milletType: String\n    +estimatedQuantity: Decimal\n    +harvestDate: Date\n    +status: String\n    --\n    +createLot(): void\n    +updateStatus(): void\n    +requestInspection(): void\n}\n\nclass Inspection {\n    +inspectionId: UUID\n    +inspectionDate: Date\n    +moisture: Decimal\n    +purity: Decimal\n    +grade: String\n    +status: String\n    --\n    +recordInspection(): void\n    +calculateGrade(): String\n    +approveLot(): void\n}\n\nclass QualityCertificate {\n    +certificateId: UUID\n    +certificateNo: String\n    +issueDate: Date\n    +validUntil: Date\n    +qualityGrade: String\n    --\n    +issueCertificate(): void\n    +validateCertificate(): Boolean\n}\n\nclass FarmerPurchaseAgreement {\n    +agreementId: UUID\n    +agreementNo: String\n    +agreedQuantity: Decimal\n    +purchasePrice: Decimal\n    +logisticsResponsibility: String\n    +status: String\n    --\n    +createAgreement(): void\n    +approveAgreement(): void\n    +rejectAgreement(): void\n    +activateAgreement(): void\n}\n\n&#39; =====================================================\n&#39; INBOUND LOGISTICS / WAREHOUSE\n&#39; =====================================================\n\nclass Shipment {\n    +shipmentId: UUID\n    +shipmentType: String\n    +scheduledDate: Date\n    +pickupLocation: String\n    +destination: String\n    +status: String\n    --\n    +scheduleShipment(): void\n    +assignVehicle(): void\n    +confirmPickup(): void\n    +confirmDelivery(): void\n    +updateStatus(): void\n}\n\nclass Vehicle {\n    +vehicleId: UUID\n    +vehicleNumber: String\n    +capacity: Decimal\n    +vehicleType: String\n    --\n    +checkCapacity(): Boolean\n}\n\nclass Driver {\n    +driverId: UUID\n    +name: String\n    +phone: String\n    +licenseNo: String\n    --\n    +updateDetails(): void\n}\n\nclass Warehouse {\n    +warehouseId: UUID\n    +name: String\n    +location: String\n    +capacity: Decimal\n    --\n    +checkCapacity(): Boolean\n    +addBatch(): void\n    +removeBatch(): void\n}\n\nclass WarehouseReceipt {\n    +receiptId: UUID\n    +receiptNo: String\n    +receivedDate: Date\n    +expectedQuantity: Decimal\n    +actualQuantity: Decimal\n    +variance: Decimal\n    +condition: String\n    +status: String\n    --\n    +recordReceipt(): void\n    +verifyQuantity(): void\n    +calculateVariance(): Decimal\n}\n\nclass WarehouseBatch {\n    +batchId: UUID\n    +availableQuantity: Decimal\n    +reservedQuantity: Decimal\n    +storageZone: String\n    +storageBin: String\n    +status: String\n    --\n    +addStock(): void\n    +reserveStock(): void\n    +moveStock(): void\n    +dispatchStock(): void\n    +getAvailableQuantity(): Decimal\n}\n\n&#39; =====================================================\n&#39; PROCESSOR / SHG PROCUREMENT\n&#39; =====================================================\n\nclass ProcessorSHG {\n    +processorId: UUID\n    +name: String\n    +organizationType: String\n    +registrationNo: String\n    +contactNo: String\n    +address: String\n    --\n    +browseLots(): void\n    +submitPurchaseRequest(): void\n    +acceptAgreement(): void\n    +rejectAgreement(): void\n}\n\nclass PurchaseRequest {\n    +requestId: UUID\n    +requestedQuantity: Decimal\n    +proposedPrice: Decimal\n    +requestDate: Date\n    +status: String\n    --\n    +submitRequest(): void\n    +withdrawRequest(): void\n}\n\nclass ProcessorPurchaseAgreement {\n    +agreementId: UUID\n    +agreementNo: String\n    +agreedQuantity: Decimal\n    +sellingPrice: Decimal\n    +logisticsResponsibility: String\n    +status: String\n    --\n    +createAgreement(): void\n    +acceptAgreement(): void\n    +rejectAgreement(): void\n    +activateAgreement(): void\n}\n\n&#39; =====================================================\n&#39; PAYMENTS\n&#39; =====================================================\n\nclass Payment {\n    +paymentId: UUID\n    +transactionNo: String\n    +amount: Decimal\n    +paymentDate: Date\n    +paymentType: String\n    +status: String\n    --\n    +initiatePayment(): void\n    +verifyPayment(): Boolean\n    +markSuccessful(): void\n}\n\n&#39; =====================================================\n&#39; MARKETPLACE\n&#39; =====================================================\n\nclass ProductListing {\n    +listingId: UUID\n    +productName: String\n    +productType: String\n    +description: String\n    +price: Decimal\n    +quantity: Decimal\n    +status: String\n    +createdDate: Date\n    --\n    +createListing(): void\n    +updateListing(): void\n    +publishListing(): void\n    +removeListing(): void\n}\n\nclass Consumer {\n    +consumerId: UUID\n    +name: String\n    +email: String\n    +phone: String\n    +address: String\n    --\n    +browseProducts(): void\n    +placeOrder(): void\n    +trackOrder(): void\n}\n\nclass ConsumerOrder {\n    +orderId: UUID\n    +orderDate: Date\n    +quantity: Decimal\n    +totalAmount: Decimal\n    +deliveryAddress: String\n    +status: String\n    --\n    +createOrder(): void\n    +cancelOrder(): void\n    +updateStatus(): void\n}\n\n&#39; =====================================================\n&#39; RELATIONSHIPS\n&#39; =====================================================\n\n&#39; Farmer - FPO\nFPO \&quot;1\&quot; -- \&quot;0..*\&quot; Farmer : manages\n\n&#39; Farmer procurement\nFarmer \&quot;1\&quot; -- \&quot;0..*\&quot; ProcurementLot : submits\nFPO \&quot;1\&quot; -- \&quot;0..*\&quot; ProcurementLot : manages\n\nProcurementLot \&quot;1\&quot; -- \&quot;0..*\&quot; Inspection : undergoes\nQualityInspector \&quot;1\&quot; -- \&quot;0..*\&quot; Inspection : performs\n\nInspection \&quot;1\&quot; -- \&quot;1\&quot; QualityCertificate : produces\n\nProcurementLot \&quot;1\&quot; -- \&quot;0..*\&quot; FarmerPurchaseAgreement : covered by\nFPO \&quot;1\&quot; -- \&quot;0..*\&quot; FarmerPurchaseAgreement : creates\nFarmer \&quot;1\&quot; -- \&quot;0..*\&quot; FarmerPurchaseAgreement : accepts\n\n&#39; Inbound shipment\nFarmerPurchaseAgreement \&quot;1\&quot; -- \&quot;0..*\&quot; Shipment : schedules\nShipment \&quot;1\&quot; -- \&quot;1\&quot; Vehicle : assigned\nShipment \&quot;1\&quot; -- \&quot;1\&quot; Driver : driven by\n\nShipment \&quot;1\&quot; -- \&quot;1\&quot; WarehouseReceipt : generates\nWarehouse \&quot;1\&quot; -- \&quot;0..*\&quot; WarehouseReceipt : receives\n\nWarehouseReceipt \&quot;1\&quot; -- \&quot;1..*\&quot; WarehouseBatch : creates\nWarehouse \&quot;1\&quot; -- \&quot;0..*\&quot; WarehouseBatch : stores\n\nWarehouseOfficer \&quot;1\&quot; -- \&quot;0..*\&quot; WarehouseReceipt : verifies\n\n&#39; Processor purchase\nProcessorSHG \&quot;1\&quot; -- \&quot;0..*\&quot; PurchaseRequest : submits\nPurchaseRequest \&quot;1\&quot; -- \&quot;1\&quot; ProcurementLot : requests\n\nFPO \&quot;1\&quot; -- \&quot;0..*\&quot; ProcessorPurchaseAgreement : proposes\nProcessorSHG \&quot;1\&quot; -- \&quot;0..*\&quot; ProcessorPurchaseAgreement : accepts\nProcurementLot \&quot;1\&quot; -- \&quot;0..*\&quot; ProcessorPurchaseAgreement : sold through\n\n&#39; Processor payment\nProcessorPurchaseAgreement \&quot;1\&quot; -- \&quot;0..1\&quot; Payment : requires\nFinanceOfficer \&quot;1\&quot; -- \&quot;0..*\&quot; Payment : processes\n\n&#39; Outbound shipment\nProcessorPurchaseAgreement \&quot;1\&quot; -- \&quot;1\&quot; Shipment : fulfilled by\nWarehouseBatch \&quot;1\&quot; -- \&quot;0..*\&quot; Shipment : dispatched through\n\n&#39; Marketplace\nProcessorSHG \&quot;1\&quot; -- \&quot;0..*\&quot; ProductListing : creates\nProcessorSHG \&quot;1\&quot; -- \&quot;0..*\&quot; ProductListing : manages\n\nProductListing \&quot;1\&quot; -- \&quot;0..*\&quot; ConsumerOrder : ordered through\nConsumer \&quot;1\&quot; -- \&quot;0..*\&quot; ConsumerOrder : places\n\nConsumerOrder \&quot;1\&quot; -- \&quot;1\&quot; Payment : paid by\nFinanceOfficer \&quot;1\&quot; -- \&quot;0..*\&quot; Payment : processes\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="slt2S68VARnp0xPa3L77-0">
          <mxCell connectable="0" parent="lgfzOhbe9lmp-KjFJ8Zx-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="1458" width="1078.87852" as="geometry" />
          </mxCell>
        </UserObject>
