        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nskinparam componentStyle rectangle\n\npackage \&quot;ShreeAnna Platform\&quot; {\n\n    [Web / Mobile UI] as UI\n\n    component \&quot;Authentication\\nService\&quot; as Auth\n    component \&quot;Farmer &amp; Listing\\nService\&quot; as Listing\n    component \&quot;FPO Management\\nService\&quot; as FPOService\n    component \&quot;Quality Inspection\\nService\&quot; as Inspection\n    component \&quot;Certification\\nService\&quot; as Certification\n    component \&quot;Marketplace\\nService\&quot; as Marketplace\n    component \&quot;Order Management\\nService\&quot; as Order\n    component \&quot;Notification\\nService\&quot; as Notification\n\n    database \&quot;ShreeAnna\\nDatabase\&quot; as DB\n    folder \&quot;Document Storage\&quot; as Storage\n}\n\nUI --&gt; Auth\nUI --&gt; Listing\nUI --&gt; FPOService\nUI --&gt; Inspection\nUI --&gt; Certification\nUI --&gt; Marketplace\nUI --&gt; Order\n\nAuth --&gt; DB\nListing --&gt; DB\nFPOService --&gt; DB\nInspection --&gt; DB\nCertification --&gt; DB\nMarketplace --&gt; DB\nOrder --&gt; DB\nNotification --&gt; DB\n\nInspection --&gt; Storage : Laboratory reports\\nInspection evidence\nCertification --&gt; Storage : Certificates\n\nListing --&gt; Notification\nInspection --&gt; Notification\nCertification --&gt; Notification\nOrder --&gt; Notification\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="B5a5kDOklE6NcKOYTYyO-1">
