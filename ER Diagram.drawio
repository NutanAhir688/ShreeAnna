  </diagram>
  <diagram name="Copy of Sequence Diagram" id="kNMh5e_JHg7SXjBqKlHJ">
    <mxGraphModel grid="0" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="MR9WVDaaK-LnsOZ_QGVa-0" />
        <mxCell id="MR9WVDaaK-LnsOZ_QGVa-1" parent="MR9WVDaaK-LnsOZ_QGVa-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle ShreeAnna Smart Millet Platform - Sequence Diagram\n\nskinparam shadowing false\nskinparam linetype ortho\nskinparam sequenceMessageAlign center\nskinparam responseMessageBelowArrow true\n\nactor Farmer\nactor \&quot;FPO / Procurement Officer\&quot; as FPO\nactor \&quot;Quality Inspector\&quot; as QI\nactor \&quot;Processor / SHG\&quot; as Processor\nactor \&quot;Logistics Officer\&quot; as LO\nactor \&quot;Warehouse Officer\&quot; as WO\nactor Consumer\n\nparticipant \&quot;ShreeAnna System\&quot; as System\n\n== Farmer &amp; Quality Inspection ==\n\nFarmer -&gt; System : 1. Submit millet lot\nSystem -&gt; FPO : 2. Notify new procurement lot\nFPO -&gt; System : 3. Request quality inspection\nSystem -&gt; QI : 4. Assign inspection\nQI -&gt; System : 5. Record inspection results\n\nalt Quality Approved\n    System -&gt; QI : 6. Issue quality certificate\n    System -&gt; FPO : 7. Notify lot approved\n\n    == Farmer Procurement ==\n\n    FPO -&gt; System : 8. Create farmer purchase agreement\n    System -&gt; Farmer : 9. Send agreement for acceptance\n    Farmer -&gt; System : 10. Accept agreement\n\n    == Inbound Logistics ==\n\n    FPO -&gt; LO : 11. Request millet pickup\n    LO -&gt; System : 12. Schedule inbound shipment\n    LO -&gt; Farmer : 13. Confirm pickup\n    LO -&gt; WO : 14. Deliver millet to warehouse\n    WO -&gt; System : 15. Verify received quantity\n    System -&gt; WO : 16. Create warehouse batch\n\n    == Processor / SHG Purchase ==\n\n    Processor -&gt; System : 17. Browse available lots\n    Processor -&gt; System : 18. Submit purchase request\n    System -&gt; FPO : 19. Notify purchase request\n    FPO -&gt; System : 20. Propose processor purchase agreement\n    System -&gt; Processor : 21. Send agreement\n\n    alt Agreement Accepted\n        Processor -&gt; System : 22. Accept agreement\n        Processor -&gt; System : 23. Make payment\n        System -&gt; FPO : 24. Confirm payment\n\n        == Outbound Logistics ==\n\n        FPO -&gt; LO : 25. Request outbound shipment\n        LO -&gt; System : 26. Schedule delivery\n        LO -&gt; WO : 27. Request stock dispatch\n        WO -&gt; System : 28. Dispatch warehouse batch\n        LO -&gt; Processor : 29. Deliver millet\n        Processor -&gt; System : 30. Confirm delivery\n\n        == Marketplace ==\n\n        Processor -&gt; System : 31. Add processed product listing\n        System -&gt; Consumer : 32. Display product\n\n        Consumer -&gt; System : 33. Place order\n        System -&gt; Consumer : 34. Confirm order\n\n    else Agreement Rejected\n        Processor -&gt; System : 22. Reject agreement\n        System -&gt; FPO : 23. Notify rejection\n    end\n\nelse Quality Rejected\n    System -&gt; FPO : 6. Notify quality rejection\n    System -&gt; Farmer : 7. Notify lot rejected\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="MR9WVDaaK-LnsOZ_QGVa-2">
          <mxCell connectable="0" parent="MR9WVDaaK-LnsOZ_QGVa-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
